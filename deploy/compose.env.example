# Environment for `docker compose` (self-hosted) — Coolify users set the same variables in the
# resource's Environment Variables tab. Copy to `.env.production` (never commit it):
#
#   cp deploy/compose.env.example .env.production && chmod 600 .env.production
#   docker compose --env-file .env.production up -d --build
#
# Every app variable is documented in src/env.ts.

# ─── Public address ────────────────────────────────────────────────
# Public URL, no trailing slash. Also the OAuth issuer and the MCP resource (${ORIGIN}/mcp).
ORIGIN=https://toolkien.example.com
# Host name only, used by the Traefik labels (Coolify raw mode / your own Traefik)
APP_DOMAIN=toolkien.example.com
# Where the app port is published for a host reverse proxy. Keep it on loopback.
APP_PUBLISH=127.0.0.1:3000

# ─── Database (Turso / libSQL) ─────────────────────────────────────
DATABASE_URL=libsql://toolkien-<org>.turso.io
DATABASE_AUTH_TOKEN=

# ─── Secrets (generate each one, never reuse) ──────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32  (app ↔ runner)
RUNNER_SHARED_SECRET=
# openssl rand -hex 32  (app ↔ egress proxy)
EGRESS_PROXY_TOKEN=
# Comma-separated platform admin emails
PLATFORM_ADMIN_EMAILS=

# ─── OpenBao (fill after `init.sh`, then restart the app) ──────────
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
OPENBAO_TRANSIT_KEY=toolkien-tokens

# ─── Networks ──────────────────────────────────────────────────────
# Self-hosted: leave as is. Coolify raw mode: PUBLIC_NETWORK=coolify, PUBLIC_NETWORK_EXTERNAL=true
PUBLIC_NETWORK=toolkien_public
PUBLIC_NETWORK_EXTERNAL=false
TRAEFIK_CERT_RESOLVER=letsencrypt

# ─── Limits (optional) ─────────────────────────────────────────────
EXEC_TIMEOUT_MS=120000
EXEC_MAX_TOOL_CALLS=200
EXEC_MAX_OUTPUT_BYTES=102400
RATE_LIMIT_EXEC_PER_MIN=60
AUDIT_RETENTION_DAYS=90
APP_MEMORY=1g
RUNNER_CPUS=2
RUNNER_MEMORY=2g
RUNNER_MAX_CONCURRENT=4
EGRESS_MAX_CONNECTIONS=256
