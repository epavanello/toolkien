{
	"name": "toolkien",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-only",
	"packageManager": "pnpm@10.32.1",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"directory:validate": "node directory/validate.ts",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/schema/auth.ts --yes && prettier --write src/lib/server/db/schema/auth.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.7.23",
		"better-auth": "^1.7.23",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rehype-slug": "^6.0.0",
		"schema-dts": "^2.1.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@better-auth/cimd": "^1.7.23",
		"@better-auth/mcp": "^1.7.23",
		"@better-auth/oauth-provider": "^1.7.23",
		"@better-auth/passkey": "^1.7.23",
		"@libsql/client": "^0.17.3",
		"@modelcontextprotocol/client": "^2.4.0",
		"@modelcontextprotocol/server": "^2.4.0",
		"@shikijs/twoslash": "^4.6.0",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"json-schema-to-typescript": "^16.0.0",
		"runed": "^0.38.0",
		"shiki": "^4.6.0",
		"undici": "^8.12.4",
		"zod": "^4.6.7"
	}
}
