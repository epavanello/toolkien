{
	"$schema": "../schema.json",
	"id": "aws-knowledge",
	"name": "AWS Knowledge",
	"tagline": "AWS documentation, regions and service availability",
	"description": "Search AWS documentation, read full pages and check which services and features are available in each region, without an AWS account.",
	"homepage": "https://awslabs.github.io/mcp/servers/aws-knowledge-mcp-server",
	"icon": "icons/aws-knowledge.png",
	"url": "https://knowledge-mcp.global.api.aws",
	"namespace": "awsKnowledge",
