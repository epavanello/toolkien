		"aws___read_documentation": {
			"annotations": {
				"readOnlyHint": true
			},
			"note": "Fetches a docs page."
		},
		"aws___list_regions": {
			"annotations": {
				"readOnlyHint": true
			}
		},
		"aws___get_regional_availability": {
			"annotations": {
				"readOnlyHint": true
			}
		}
	},
	"verification": {
		"status": "tested",
		"by": "toolkien-maintainers",
		"on": "2026-11-14",
		"notes": "Public, no authentication. tools/list inspected anonymously on 2026-11-14 (5 tools)."
	}
}
