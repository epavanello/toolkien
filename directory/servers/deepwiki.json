{
	"$schema": "../schema.json",
	"id": "deepwiki",
	"name": "DeepWiki",
	"description": "Ask questions about public GitHub repositories and read their generated wikis.",
	"homepage": "https://docs.devin.ai/work-with-devin/deepwiki-mcp",
	"icon": "icons/deepwiki.png",
	"url": "https://mcp.deepwiki.com/mcp",
	"namespace": "deepwiki",
	"publisher": "official",
	"category": "knowledge",
	"tags": ["docs", "code"],
	"auth": {
		"type": "none"
	},
	"tools": {
		"read_wiki_structure": {
			"annotations": {
				"readOnlyHint": true,
				"openWorldHint": true
			}
		},
		"read_wiki_contents": {
			"annotations": {
				"readOnlyHint": true,
				"openWorldHint": true
			}
		},
		"ask_question": {
			"annotations": {
				"readOnlyHint": true,
				"openWorldHint": true
			}
		}
	},
	"verification": {
		"status": "tested",
		"by": "toolkien-maintainers",
		"on": "2026-11-14",
		"notes": "Public repositories only, no authentication. tools/list inspected anonymously (3 tools, no annotations reported: treated as writes until confirmed)."
	}
}
