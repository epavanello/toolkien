# Copy to `.env` for local development. Every variable is documented in `src/env.ts`.

# ─── Database (libSQL) ─────────────────────────────────────────────
# Local file; production uses the Turso URL (libsql://…, EU region) + auth token
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# ─── App and auth ──────────────────────────────────────────────────
ORIGIN=http://localhost:5173
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated platform admin emails
PLATFORM_ADMIN_EMAILS=

# ─── Google sign-in (optional) ────────────────────────────────────
# Both or neither. Google Cloud → OAuth client "Web application", authorized redirect URI:
# http://localhost:5173/api/auth/callback/google (i.e. ${ORIGIN}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (Resend) ────────────────────────────────────────────────
# Passwordless sign-in and invitations. Empty in dev: links and codes print to the console.
RESEND_API_KEY=
# Sender on a domain verified in Resend (EU region recommended)
EMAIL_FROM=
RESEND_BASE_URL=

# ─── Secrets (OpenBao transit) ─────────────────────────────────────
# Leave OPENBAO_ADDR empty in dev to use TOOLKIEN_DEV_MASTER_KEY instead
OPENBAO_ADDR=
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
OPENBAO_TRANSIT_KEY=toolkien-tokens
# Development only (refused in production): openssl rand -base64 32
TOOLKIEN_DEV_MASTER_KEY=

# ─── Runner and egress ─────────────────────────────────────────────
# Empty in dev: the app starts a local supervisor with your `deno` (random port and secret).
# Production: ws://runner:8787 (set by docker-compose.yml) + the shared secret.
RUNNER_URL=
# openssl rand -hex 32 (only with RUNNER_URL)
RUNNER_SHARED_SECRET=
# Empty in dev: upstream calls go out directly (still SSRF-checked)
EGRESS_PROXY_URL=

# ─── Limits ────────────────────────────────────────────────────────
EXEC_TIMEOUT_MS=120000
EXEC_MAX_TOOL_CALLS=200
EXEC_MAX_OUTPUT_BYTES=102400
RATE_LIMIT_EXEC_PER_MIN=60
AUDIT_RETENTION_DAYS=90
